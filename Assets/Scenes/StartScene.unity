  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Monk
  portrait: {fileID: 21300000, guid: 06eaeab3d897712428ce8a26b403a4a7, type: 3}
  lines:
  - speaker: Monk
    text: Greetings, traveler Ninja. I am the Monk.
  - speaker: Monk
    text: This is a vast, vibrant world brimming with adventure.
  - speaker: Monk
    text: You must keep gaining vitality and new abilities, defeat your foes, and
      grow ever stronger.
  - speaker: Monk
    text: Without further ado, let us begin our journey at once.
  - speaker: Monk
    text: You can first go to Caveman to buy some food or weapons.
  repeatLines:
  - speaker: Monk
    text: Go explore the world, Ninja!
  questPanel: {fileID: 0}
